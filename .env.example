# ---------------------------------------------------------------------------
# Base de datos (Neon Postgres, región AWS Frankfurt para ir a juego con fra1)
# ---------------------------------------------------------------------------
# Cadena "pooled" del panel de Neon. El driver @neondatabase/serverless habla
# por HTTP, así que no hay problemas de pool en serverless.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Autenticación (Better Auth, el mismo motor que usa Neon Auth por debajo)
# ---------------------------------------------------------------------------
# Genera uno con:  openssl rand -base64 32
# Secreto con el que se firma la cookie de sesión. 32 bytes en base64:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
# URL de Neon Auth (panel de Neon, pestaña Auth).
NEON_AUTH_URL=""

# ---------------------------------------------------------------------------
# URL pública de la aplicación.
#
# CUIDADO: es de COMPILACIÓN, no de ejecución. Al llevar el prefijo
# NEXT_PUBLIC_, Next la sustituye por su valor literal dentro del código
# durante `next build`. Definirla después en Cloudflare NO cambia nada de lo
# ya compilado. Si se compila con "localhost", el feed iCal y los enlaces de
# los correos salen apuntando a localhost.
#
# Para Cloudflare hay que compilar con ella puesta:
#   NEXT_PUBLIC_APP_URL=https://calendario-esgrima.<subdominio>.workers.dev \
#     npm run cf:build
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email transaccional (Resend). Plan Free: 3.000/mes, 100/día.
# Para escribir a terceros hace falta un dominio verificado; con el dominio de
# pruebas de Resend solo puedes enviarte a ti mismo.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Tope de envíos diarios. El plan gratuito de Resend son 100/día.
RESEND_DAILY_LIMIT="100"
EMAIL_FROM="Calendario Esgrima <avisos@tu-dominio.es>"
ADMIN_ALERT_EMAIL="admin@tu-dominio.es"

# ---------------------------------------------------------------------------
# Cron.
#
# En Cloudflare los disparadores están en `wrangler.jsonc` (`triggers.crons`) y
# el reparto cron -> ruta en `worker/index.ts`. El manejador `scheduled`
# construye la petición con la cabecera `Authorization: Bearer $CRON_SECRET`,
# igual que hacía Vercel, así que las rutas de `src/app/api/cron/**` no
# cambian y siguen exigiendo el secreto.
#
# Sin esta variable, en producción las rutas responden 503 en lugar de
# quedarse abiertas.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Almacenamiento de ficheros (PDFs de convocatoria y snapshots del scraper).
#
# Se elige solo, por este orden:
#
#  1. Cloudflare R2, si el Worker trae el binding `ARCHIVOS` (definido en
#     `wrangler.jsonc`). No es una variable de entorno: es un binding. Crea el
#     cubo con:
#         npx wrangler r2 bucket create calendario-esgrima-archivos
#  2. Neon Object Storage (compatible con S3), con las cuatro AWS_* de abajo.
#     Es lo que se usa en local y en los guiones de `tsx`, donde no hay
#     bindings.
#
# Si no hay ninguno, la aplicación sigue funcionando: no se guardan PDFs ni
# snapshots y se dice en pantalla.
#
# El backend de Vercel Blob se retiró al migrar a Cloudflare.
# ---------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"

# Solo si algún día se pone un dominio propio delante del cubo de R2. Vacío,
# los ficheros de R2 se sirven por la propia aplicación, en /api/archivos/...,
# que es lo que se quiere: los PDFs de convocatoria llevan listas nominales y
# un cubo con URL pública de r2.dev es un directorio de datos personales.
R2_PUBLIC_BASE_URL=""

# Guardar el HTML crudo de cada ejecución ayuda a depurar un parseo roto sin
# volver a pedir la página. Ponlo a "false" para ahorrar escrituras.
INGEST_SNAPSHOT_HTML="true"

# ---------------------------------------------------------------------------
# Identificación del scraper ante las fuentes (buena educación y trazabilidad)
# ---------------------------------------------------------------------------
INGEST_USER_AGENT="CalendarioEsgrima/1.0 (+https://tu-dominio.es/contacto)"
# Licencias que se resuelven como mucho en una pasada de ranking. Se sube
# solo para una carga inicial; en el día a día sobra con el valor por defecto.
INGEST_RANKING_LICENSE_BUDGET="150"

# ---------------------------------------------------------------------------
# Fase 8 (opcional): extracción asistida por IA de los dossieres en PDF.
# IMPORTANTE: el tier GRATUITO de Gemini entrena con lo que le mandas. Solo
# documentos SIN datos personales. Las listas nominales de convocados van en
# tier de pago o no se procesan.
# ---------------------------------------------------------------------------
AI_EXTRACTION_ENABLED="false"
AI_PROVIDER="workers_ai"          # workers_ai | gemini | openrouter
AI_API_KEY=""
AI_MODEL=""
# Con AI_PROVIDER="workers_ai" dentro del Worker no hace falta nada más: se
# usa el binding `AI` de `wrangler.jsonc`. Fuera del Worker (guiones de `tsx`)
# se necesitan estas dos, con permiso de Workers AI.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# "false" = la clave es de tier gratuito -> se bloquean los documentos con
# posibles datos personales. Ponlo a "true" solo con una clave de pago.
AI_PAID_TIER="false"

# ---------------------------------------------------------------------------
# Fase 10 (opcional): envío directo de inscripciones a Skermo.
# Arranca SIEMPRE en modo simulación (dry run): construye la petición y la
# registra, sin enviarla. No se activa hasta comparar con lo que hace el
# navegador. El export CSV nunca se retira del producto.
# ---------------------------------------------------------------------------
SKERMO_SUBMIT_ENABLED="false"
SKERMO_SUBMIT_DRY_RUN="true"
SKERMO_BASE_URL="https://app.skermo.org"
# Solo si se decide recordar la sesión del club (opción 2 del plan).
# 32 bytes en base64:  openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=""

# Segunda puerta de acceso, con contraseña, además del código por correo.
# Se enciende con "1". Hace falta mientras Resend no tenga un dominio
# verificado, porque sin él los códigos solo llegan al titular de la cuenta y
# no podría entrar nadie más. Quitar esta variable la cierra.
ACCESO_CON_CONTRASENA=

# ---------------------------------------------------------------------------
# DESPLIEGUE EN CLOUDFLARE
# ---------------------------------------------------------------------------
# Este fichero es para desarrollo. En Cloudflare las variables se reparten en
# tres sitios distintos y conviene no mezclarlos:
#
#  a) `vars` de `wrangler.jsonc`  -> lo que NO es secreto y se versiona:
#     NEXT_PUBLIC_APP_URL, INGEST_SNAPSHOT_HTML, INGEST_USER_AGENT,
#     RESEND_DAILY_LIMIT, AI_*, SKERMO_*.
#
#  b) `npx wrangler secret put <NOMBRE>` -> todo lo que sea una credencial,
#     uno por uno y sin que el valor pase por ningún fichero versionado:
#     DATABASE_URL, NEON_AUTH_URL, NEON_AUTH_COOKIE_SECRET, CRON_SECRET,
#     CREDENTIAL_ENCRYPTION_KEY, las cuatro AWS_* si se usa Neon Object
#     Storage en vez de R2, RESEND_API_KEY, EMAIL_FROM, ADMIN_ALERT_EMAIL,
#     AI_API_KEY y ACCESO_CON_CONTRASENA (valor "1") mientras la puerta de
#     contraseña siga abierta.
#
#  c) Bindings de `wrangler.jsonc` -> no son variables: ARCHIVOS (R2),
#     AI (Workers AI), IMAGES (transformación de imágenes), ASSETS.
#
# Y recuerda lo de NEXT_PUBLIC_APP_URL: esa hay que tenerla puesta al
# COMPILAR, no basta con ponerla como secreto.
#
# Credenciales de wrangler para desplegar desde la línea de órdenes
# (alternativa a `npx wrangler login`):
#   CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID (ya declaradas arriba).
