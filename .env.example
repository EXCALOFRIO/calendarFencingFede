# ---------------------------------------------------------------------------
# Base de datos (Neon Postgres, región AWS Frankfurt para ir a juego con fra1)
# ---------------------------------------------------------------------------
# Cadena "pooled" del panel de Neon. El driver @neondatabase/serverless habla
# por HTTP, así que no hay problemas de pool en serverless.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Autenticación (Better Auth, el mismo motor que usa Neon Auth por debajo)
# ---------------------------------------------------------------------------
# Genera uno con:  openssl rand -base64 32
# Secreto con el que se firma la cookie de sesión. 32 bytes en base64:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
# URL de Neon Auth (panel de Neon, pestaña Auth).
NEON_AUTH_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email transaccional (Resend). Plan Free: 3.000/mes, 100/día.
# Para escribir a terceros hace falta un dominio verificado; con el dominio de
# pruebas de Resend solo puedes enviarte a ti mismo.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Tope de envíos diarios. El plan gratuito de Resend son 100/día.
RESEND_DAILY_LIMIT="100"
EMAIL_FROM="Calendario Esgrima <avisos@tu-dominio.es>"
ADMIN_ALERT_EMAIL="admin@tu-dominio.es"

# ---------------------------------------------------------------------------
# Cron. Vercel inyecta CRON_SECRET automáticamente en las invocaciones de cron;
# defínelo en las variables de entorno del proyecto y las rutas lo exigen.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Vercel Blob (PDFs de convocatoria y snapshots de HTML del scraper)
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
# Guardar el HTML crudo de cada ejecución ayuda a depurar un parseo roto sin
# volver a pedir la página. Ponlo a "false" para ahorrar operaciones de Blob.
INGEST_SNAPSHOT_HTML="true"

# ---------------------------------------------------------------------------
# Identificación del scraper ante las fuentes (buena educación y trazabilidad)
# ---------------------------------------------------------------------------
INGEST_USER_AGENT="CalendarioEsgrima/1.0 (+https://tu-dominio.es/contacto)"

# ---------------------------------------------------------------------------
# Fase 8 (opcional): extracción asistida por IA de los dossieres en PDF.
# IMPORTANTE: el tier GRATUITO de Gemini entrena con lo que le mandas. Solo
# documentos SIN datos personales. Las listas nominales de convocados van en
# tier de pago o no se procesan.
# ---------------------------------------------------------------------------
AI_EXTRACTION_ENABLED="false"
AI_PROVIDER="gemini"              # gemini | openrouter
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
# "false" = la clave es de tier gratuito -> se bloquean los documentos con
# posibles datos personales. Ponlo a "true" solo con una clave de pago.
AI_PAID_TIER="false"

# ---------------------------------------------------------------------------
# Fase 10 (opcional): envío directo de inscripciones a Skermo.
# Arranca SIEMPRE en modo simulación (dry run): construye la petición y la
# registra, sin enviarla. No se activa hasta comparar con lo que hace el
# navegador. El export CSV nunca se retira del producto.
# ---------------------------------------------------------------------------
SKERMO_SUBMIT_ENABLED="false"
SKERMO_SUBMIT_DRY_RUN="true"
SKERMO_BASE_URL="https://app.skermo.org"
# Solo si se decide recordar la sesión del club (opción 2 del plan).
# 32 bytes en base64:  openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=""

# Segunda puerta de acceso, con contraseña, además del código por correo.
# Se enciende con "1". Hace falta mientras Resend no tenga un dominio
# verificado, porque sin él los códigos solo llegan al titular de la cuenta y
# no podría entrar nadie más. Quitar esta variable la cierra.
ACCESO_CON_CONTRASENA=
