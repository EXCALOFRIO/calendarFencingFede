# Cabeceras de Workers Static Assets (https://developers.cloudflare.com/workers/static-assets/headers).
# OpenNext copia public/* a .open-next/assets/ y Wrangler sube este fichero como configuración,
# no como un fichero servible. Solo afecta a lo que se sirve desde los assets, no al Worker.

# El trabajador de servicio: el navegador debe comprobar siempre si hay uno nuevo
# (un sw.js cacheado dejaría a los dispositivos con la versión vieja) y nunca
# interpretarlo como otro tipo de contenido.
/sw.js
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Everything under /_next/static has a content hash or the build id in its path, so it never
# changes: without this the assets default (max-age=0, must-revalidate) costs a 304 per file.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, flags and icons have NO hash in their names, so not `immutable`: 30 days fresh, then
# served from cache while revalidating. Replacing one in place takes up to 30 days to reach
# every device; give it a new name when it must change at once.
/fotos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/banderas/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/iconos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000
