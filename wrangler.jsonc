{
  "$schema": "node_modules/wrangler/config-schema.json",

  /**
   * Nombre del Worker y, por tanto, primera parte de la URL:
   * https://calendario-fie-fede.<subdominio-de-la-cuenta>.workers.dev
   *
   * El subdominio de la cuenta (`excalofrio`) lo comparten los dieciséis
   * Workers que hay, y solo se puede cambiar desde el panel: por API, el
   * `PUT` responde `10036 Account already has an associated subdomain` y el
   * `PATCH`, `10405 Method not allowed for this authentication scheme`.
   *
   * Esta parte, la del nombre del Worker, sí se elige aquí, y es la que se
   * lee primero.
   */
  "name": "calendario-fie-fede",

  // Sin URLs de vista previa por versión (`<version>-calendario-fie-fede…`):
  // servirían versiones antiguas con los bindings de producción. `workers_dev`
  // no se toca: es la URL de producción.
  "preview_urls": false,

  // Punto de entrada PROPIO, no el generado. `worker/index.ts` reexporta el
  // `fetch` que produce OpenNext y añade el manejador `scheduled` que
  // sustituye a los crons de Vercel. Ver worker/index.ts.
  "main": "worker/index.ts",

  /**
   * Fecha de compatibilidad.
   *
   * Tiene que ser >= 2025-04-01 para que `process.env` se rellene con las
   * variables y los secretos del Worker (bandera
   * `nodejs_compat_populate_process_env`, activa por defecto a partir de esa
   * fecha). Todo el código de la aplicación lee `process.env`, así que esto
   * no es opcional.
   */
  "compatibility_date": "2026-09-15",

  /**
   * `nodejs_compat`: node:crypto y node:buffer, que usan
   *   src/lib/skermo/credentials.ts y las dependencias de Next.
   * `global_fetch_strictly_public`: que un `fetch()` a nuestro propio dominio
   *   salga a Internet en lugar de cortocircuitar dentro del Worker. Lo pide
   *   OpenNext para que el comportamiento coincida con el de Node.
   */
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Ficheros estáticos (/_next/static, /public) servidos por Cloudflare, no
  // por el Worker: no cuentan como invocación.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  /**
   * Optimización de imágenes de `next/image`.
   *
   * El Worker atiende `/_next/image` y transforma con este binding: descarga
   * el original (por ejemplo el cartel de `static.fie.org`), lo redimensiona
   * en memoria y lo devuelve. **No guarda copia en ningún sitio.**
   *
   * Se usa el binding y NO un loader hacia `/cdn-cgi/image/...` porque esa
   * ruta necesita una zona de Cloudflare con transformaciones activadas y
   * aquí servimos desde `workers.dev`, que no es una zona. El propio worker
   * generado por OpenNext lo dice: «"/cdn-cgi/image/..." requests do not
   * reach production workers».
   *
   * Coste: 5.000 transformaciones únicas al mes gratis, y una transformación
   * repetida no vuelve a contar en el mes.
   */
  "images": {
    "binding": "IMAGES"
  },

  /**
   * Techo de CPU por invocación (HTTP y scheduled). 30 s es el valor por
   * defecto de Workers Paid; se fija para que no se pueda subir sin querer
   * y para cortar una petición desbocada. Los crons de ingestión y de
   * extracción de PDF son lo más pesado: si alguno se corta, se sube aquí
   * (máximo 300000) en lugar de quitarlo.
   */
  "limits": {
    "cpu_ms": 30000
  },

  /**
   * Smart Placement: a server-rendered page makes several sequential D1
   * queries (a cold profile up to ~45), and each one pays the round trip
   * between the edge location and the database. Cloudflare moves the Worker
   * next to D1 once it has seen enough traffic; static assets and KV reads are
   * unaffected. `"mode": "off"` undoes it without a code change.
   */
  "placement": {
    "mode": "smart"
  },

  /**
   * Límites de peticiones (Rate Limiting API de Workers). Los aplica
   * `src/lib/seguridad/limites.ts` desde worker/index.ts antes de servir.
   * `namespace_id` es un entero elegido aquí, único en la CUENTA (no hay que
   * crear nada): si otro de los Workers de la cuenta usara el mismo número,
   * compartirían contadores. `period` sólo admite 10 o 60 segundos.
   *
   * Acceso: 20 y no 10 por minuto e IP porque en un pabellón o con CGNAT
   * muchas personas comparten IP, y cada entrada son dos POST; detrás siguen
   * los límites exactos de D1 (5 envíos/min e IP, 1/min por correo).
   * IP_SESION: tope por IP de las rutas que cuentan por sesión, para que
   * inventarse una cookie nueva en cada petición no estrene contador; 3000 y
   * no 600 porque un pabellón con wifi compartida o CGNAT es una sola IP.
   * ACCIONES: todo POST fuera de /api/ (salvo el de /entrar, que es acceso),
   * lleve o no la cabecera Next-Action.
   * PAGINAS: por IP, lo que no cae en ninguna otra regla (páginas, peticiones
   * RSC, /api/notificaciones…); es el freno general frente a un rastreo.
   */
  "ratelimits": [
    { "name": "LIMITE_ACCESO", "namespace_id": "84101", "simple": { "limit": 20, "period": 60 } },
    { "name": "LIMITE_CRON", "namespace_id": "84102", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIMITE_IMAGENES", "namespace_id": "84103", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_SUGERENCIAS", "namespace_id": "84104", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIMITE_FOTOS", "namespace_id": "84105", "simple": { "limit": 120, "period": 60 } },
    { "name": "LIMITE_ARCHIVOS", "namespace_id": "84106", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIMITE_ACCIONES", "namespace_id": "84107", "simple": { "limit": 120, "period": 60 } },
    { "name": "LIMITE_IP_SESION", "namespace_id": "84108", "simple": { "limit": 3000, "period": 60 } },
    { "name": "LIMITE_PAGINAS", "namespace_id": "84109", "simple": { "limit": 1200, "period": 60 } }
  ],

  /**
   * Crons. Traducción literal de `vercel.json`, una franja por fuente para que
   * una fuente lenta no arrastre a las demás. Las horas son UTC.
   *
   * El reparto cron -> ruta está en worker/index.ts; si tocas una expresión
   * aquí, tócala también allí o esa ejecución no hará nada.
   *
   * OJO: el plan gratuito de Workers permite 5 Cron Triggers por CUENTA y
   * estos son 9. Hace falta Workers Paid (ver informe).
   */
  "triggers": {
    "crons": [
      "0 3 * * *",
      "30 3 * * *",
      "0 4 * * *",
      "30 4 * * *",
      "0 5 * * *",
      "30 5 * * *",
      "0 6 * * *",
      "45 6 * * *",
      "0 7 * * *",
      // Resultados automáticos (/api/cron/resultados), cada hora fuera de la franja de los diarios.
      "20 0-2,8-23 * * *"
    ]
  },

  /**
   * Workers AI, para la extracción asistida de las circulares en PDF
   * (`src/lib/ai/extract.ts`, que lo busca como `env.AI`).
   *
   * Es el camino barato, y además el que **no necesita permisos de token**:
   * dentro del Worker, Cloudflare inyecta el binding, así que no hacen falta
   * ni `CLOUDFLARE_ACCOUNT_ID` ni `CLOUDFLARE_API_TOKEN`. Esos dos solo los
   * usa la vía REST, que es el respaldo para cuando el código corre fuera de
   * un Worker (local, `tsx`, Vitest). La capa gratuita son 10.000 neurons al
   * día.
   */
  "ai": {
    "binding": "AI"
  },

  /**
   * Almacenamiento de PDFs de convocatoria y snapshots del scraper.
   *
   * R2 es obligatorio: no se usa almacenamiento externo como respaldo ni una
   * URL pública para saltarse el control de sesión. El cubo ya existe, es
   * privado y no tiene dominio público habilitado. Para una instalación nueva:
   *
   *   npx wrangler r2 bucket create calendario-esgrima-archivos
   */
  "r2_buckets": [
    {
      "binding": "ARCHIVOS",
      "bucket_name": "calendario-esgrima-archivos"
    }
  ],

  /**
   * Caché compartida de datos que no dependen de la cuenta (src/lib/cache):
   * sin este binding la caché queda solo en la memoria de cada isolate.
   */
  "kv_namespaces": [
    {
      "binding": "CACHE_DATOS",
      "id": "2edbbc5335a0435fa5844899ac49d4eb"
    }
  ],

  /**
   * Datos consultables de la aplicación. Base nueva e independiente de las
   * otras aplicaciones, con jurisdicción UE. El código no vuelve a Neon si
   * falta este binding.
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendario-fie-fede-db",
      "database_id": "e1c28f19-278c-4d8f-9c7c-9b9d1c45653e",
      "migrations_dir": "drizzle-d1"
    }
  ],

  /**
   * Variables NO secretas. Los secretos van con `wrangler secret put`, uno a
   * uno, y NUNCA aquí (este fichero se versiona).
   */
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://calendario-fie-fede.excalofrio.workers.dev",
    "INGEST_SNAPSHOT_HTML": "true",
    "INGEST_USER_AGENT": "CalendarioEsgrima/1.0 (+https://calendario-fie-fede.excalofrio.workers.dev)",
    "RESEND_DAILY_LIMIT": "100",
    // Códigos de acceso al día en toda la app, sólo a correos invitados. Los
    // envía Neon Auth, no Resend. Ver `otpDailyLimit` en src/lib/auth/rate-limit.ts.
    "AUTH_OTP_DAILY_LIMIT": "2000",
    // Asignación propia de 8 GiB (techo del CHECK de sport_write_context tras
    // 0005), por debajo de los 10 GB por base de D1 en el plan de pago. No es un
    // tope de gasto, no activa el incremental ni modifica el plan de facturación.
    "D1_STORAGE_BUDGET_BYTES": "8589934592",
    "SPORT_INCREMENTAL_ENABLED": "false",
    // Resultados automáticos (/api/cron/resultados), con su franja en
    // triggers.crons; necesita 0017 aplicada. La IA solo lee los PDF que el
    // lector determinista no completa, con validación estricta y tope diario
    // (docs/tareas-programadas.md).
    "RESULTADOS_AUTO_ENABLED": "true",
    "RESULTADOS_AUTO_IA_ENABLED": "true",
    // Clave pública VAPID de las notificaciones push; la privada es el secreto
    // VAPID_PRIVATE_KEY.
    "VAPID_PUBLIC_KEY": "BM73BDdcqk5EE6aUCmV6h2v044g9fOT6oTBU2_tLK8RMKelGX-8IYMk5GqNY1nanStlNL3PbZufMDLfKjp3gvL4",
    // Solo se activa deliberadamente para congelar escrituras durante el corte.
    "MIGRATION_MAINTENANCE": "false",
    // Encendida. Con el interruptor en "false" el cron de extracción responde
    // 200 explicando que no hizo nada, y el resto de la aplicación no se
    // entera: la IA es opcional en este proyecto.
    "AI_EXTRACTION_ENABLED": "true",
    "AI_PROVIDER": "workers_ai",
    /**
     * Modelo de extracción.
     *
     * Antes estaba `@cf/google/gemma-4-26b-a4b-it` y daba CINCO errores de
     * cinco: devuelve el sobre de chat-completions (no `{response}`) y además
     * se gasta el presupuesto de salida razonando, así que deja el JSON
     * vacío. Con el parseo ya arreglado, medido sobre diez dossieres reales
     * (`tests/modelos-workers-ai.mts`), seguía dando 0 de 6.
     *
     * `@cf/zai-org/glm-5.3-flash`: 1.310.720 tokens de ventana, acepta
     * `reasoning_effort: "low"` (y con eso no gasta nada en razonar), 0,15 $ /
     * 0,50 $ por millón. En la prueba real: 6 de 6 documentos válidos, 71
     * campos con cita verificada y ~71 neurons por documento, el más barato de
     * los que tienen ventana grande. Ver `MODELO_POR_DEFECTO` en
     * `src/lib/ai/extract.ts` para los descartados y por qué.
     *
     * Si hay que cambiarlo, esta variable manda sobre el valor del código, y
     * las manías del modelo (cómo se llama su tope de salida, si acepta frenar
     * el razonamiento) salen de `PERFILES_MODELO`. Un modelo que no esté ahí
     * usa el perfil conservador y puede devolver vacío.
     */
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "AI_PAID_TIER": "false",
    "SKERMO_SUBMIT_ENABLED": "false",
    "SKERMO_SUBMIT_DRY_RUN": "true",
    "SKERMO_BASE_URL": "https://app.skermo.org"
  }
}
